# Copy to .env and fill in. .env is gitignored. Never commit real values.

# Database for scripts (npm run db:test). Default: the local Supabase stack from `supabase start`.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Supabase project (Project Settings -> API). URL + anon key are safe to share with the app team.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Never share, never ship in the app.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API key for verify-quest (server-only). From Google AI Studio or the hackathon's credits.
GEMINI_API_KEY=
