# Copy to .env and fill in. .env is gitignored. Never commit real values.

# Local Docker database (npm run db:up). This default is what scripts use if unset.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fogofwar
# Optional: change the host port if 5432 is taken (then update DATABASE_URL to match).
# DB_PORT=5432

# Tiger Cloud service connection string (used by npm run db:migrate:tiger, and later as an Edge Function secret).
TIGER_DATABASE_URL=

# Supabase project (Project Settings -> API). URL + anon key are safe to share with the app team.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Never share, never ship in the app.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API key for verify-quest (server-only).
ANTHROPIC_API_KEY=
