{
  "name": "fog-of-war-backend-tools",
  "private": true,
  "description": "Node tooling for the Fog of War IRL backend (schema tests, seeds, scripts). The iOS app is separate.",
  "type": "module",
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:test": "node scripts/db/test-schema.mjs",
    "functions:serve": "supabase functions serve --env-file supabase/functions/.env",
    "functions:smoke": "node scripts/functions/smoke.mjs",
    "functions:deploy": "supabase functions deploy"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "postgres": "^4.1.1"
  },
  "devDependencies": {
    "h3-js": "^4.2.1"
  }
}
